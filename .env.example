# Modèle des variables d'environnement. Aucun secret réel dans le dépôt :
# en ligne, toutes ces valeurs viennent de Secret Manager.
#
# En local, deux fichiers, tous deux ignorés par git :
# - .env : seulement DATABASE_URL ci-dessous, lue à la fois par Prisma et par Next.js ;
# - .env.local : les secrets (toutes les autres variables), lus par Next.js seulement.
# Ne pas recopier DATABASE_URL dans .env.local : Next.js la préférerait à celle de .env,
# et Prisma et l'application ne viseraient plus la même base.

# Base de données (port 5434 : voir docker-compose.yml)
DATABASE_URL="postgresql://choofauto:choofauto@localhost:5434/choofauto?schema=public"

# Connexion du personnel (Auth.js, Google)
# Clé de chiffrement des sessions : 32 octets aléatoires en base64, propre à chaque environnement.
AUTH_SECRET=""
# Identifiant OAuth Google (Google Cloud, « Identifiants ») ; adresse de retour :
# http://localhost:3000/api/auth/callback/google en local.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Adresses du personnel autorisées, séparées par des virgules. Le seed crée un compte par adresse.
STAFF_EMAIL_ALLOWLIST="prenom.nom@example.com,autre.personne@example.com"
# En ligne seulement (Cloud Run) : adresse publique du site, pour Auth.js. Inutile en local.
AUTH_URL=""

# Modèles de langage : principal Anthropic, repli AI Forge (compatible OpenAI)
ANTHROPIC_API_KEY=""
LLM_PRIMARY_MODEL="claude-haiku-5-5"
LLM_FALLBACK_BASE_URL=""
LLM_FALLBACK_API_KEY=""
LLM_FALLBACK_MODEL=""
LLM_MONTHLY_BUDGET_USD="50"

# Stockage et suivi des erreurs
GCS_BUCKET=""
SENTRY_DSN=""
