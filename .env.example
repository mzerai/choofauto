# Copier en .env.local pour le développement. Aucun secret réel dans le dépôt :
# en ligne, toutes ces valeurs viennent de Secret Manager.

# Base de données
DATABASE_URL="postgresql://choofauto:choofauto@localhost:5432/choofauto?schema=public"

# Connexion du personnel (Auth.js, Google)
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
STAFF_EMAIL_ALLOWLIST="fondateur@choofauto.tn,cofondatrice@choofauto.tn"

# Modèles de langage : principal Anthropic, repli AI Forge (compatible OpenAI)
ANTHROPIC_API_KEY=""
LLM_PRIMARY_MODEL="claude-haiku-5-5"
LLM_FALLBACK_BASE_URL=""
LLM_FALLBACK_API_KEY=""
LLM_FALLBACK_MODEL=""
LLM_MONTHLY_BUDGET_USD="50"

# Stockage et suivi des erreurs
GCS_BUCKET=""
SENTRY_DSN=""
